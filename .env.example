# Telegram Bot Token — 从 @BotFather 创建机器人后获取
# 形如: 123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_BOT_TOKEN=

# 可选：自托管 Telegram Bot API 服务器地址。
# 留空使用官方 https://api.telegram.org。
# 自托管示例：http://127.0.0.1:8081（不要带末尾 `/`）。
# 使用 --local 启动官方 telegram-bot-api 时，视频上传上限可提高到 2 GB。
TELEGRAM_API_ROOT=

# === Webhook 自动注册（启动时经 instrumentation hook 执行 setWebhook） ===
# 完整回调地址,例如 https://site--xxx.code.run/api/webhook。
# 留空则跳过注册(本地开发无需设置)。
TELEGRAM_WEBHOOK_URL=
# 可选但生产环境建议设置:webhook secret。设置后 Telegram 会在每个回调带
# X-Telegram-Bot-Api-Secret-Token 头,/api/webhook 路由会强制校验。
# 用 `openssl rand -hex 24` 生成。
TELEGRAM_WEBHOOK_SECRET=

# === MTProto / mtcute（突破 Bot API 50MB 上传上限，支持到 2GB） ===
# 在 https://my.telegram.org 免费申请 api_id & api_hash
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# 持久化的 MTProto session 字符串（由 scripts/auth-mtproto.ts 一次性生成）。
# 留空时进程会以 bot token 登录并把新 session 打印到日志，需要把它再贴回这里。
TELEGRAM_MT_PROTO_SESSION=

# === 下载去重（临时方案,防短时间内重复下载同一推文） ===
# 去重状态存储的 SQLite 文件路径。默认位于系统临时目录
# (Docker 容器内 /app 对 nextjs 用户只读,默认路径不能用 CWD)。
# 仅在需要自定义位置时设置（本地状态,可删除重建）
DEDUP_DB_PATH=
# 正在处理任务的租约时长（毫秒,默认 600000=10分钟,超时可被接管,防永久阻塞）
DEDUP_PROCESSING_LEASE_MS=
# 已完成的去重保留窗口（毫秒,默认 900000=15分钟,窗口内同推文跳过重复下载）
DEDUP_DONE_TTL_MS=
# 失败后允许重试的冷却期（毫秒,默认 120000=2分钟）
DEDUP_FAILED_COOLDOWN_MS=
# Telegram update_id 去重窗口（毫秒,默认 86400000=24小时,拦截 webhook 重投）
DEDUP_UPDATE_TTL_MS=
# /api/download 重复请求等待进行中的任务的最长时间（毫秒,默认 45000,超时返回 202）
DEDUP_WAIT_MS=

# === 下载任务队列(SQLite,进程内 worker 消费;webhook 与 /api/download 都走它) ===
# 并发消费数。免费档容器建议 1(串行,控制内存峰值;大视频下载全程驻内存)。
QUEUE_CONCURRENCY=1
# worker 轮询间隔(毫秒,默认 500)
# QUEUE_POLL_MS=500
# 失败重试退避基数(毫秒,默认 60000;实际延迟 = 已失败次数 × 基数)
# QUEUE_BACKOFF_BASE_MS=60000
# 最大尝试次数含首次(默认 3),耗尽后标记 failed 并向会话发一条错误提示
# QUEUE_MAX_ATTEMPTS=3
# job 执行租约(毫秒,默认 1200000=20分钟;逾期视为崩溃残留可被回收重跑)
# QUEUE_LEASE_MS=1200000
# /api/download 同步等待终态的超时(毫秒,默认 480000;超时返回 202,任务继续后台跑)
# QUEUE_WAIT_TIMEOUT_MS=480000
# 队列数据库文件路径。默认在系统临时目录(Docker 内 /app 只读;容器无持久卷,
# 重启即失属设计内取舍)。仅自定义位置时设置。
# QUEUE_DB_PATH=
# done/failed 记录保留期(毫秒,默认 86400000=24小时)
# QUEUE_RETENTION_MS=86400000

