# Telegram Bot Token — 从 @BotFather 创建机器人后获取
# 形如: 123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_BOT_TOKEN=

# 可选：自托管 Telegram Bot API 服务器地址。
# 留空使用官方 https://api.telegram.org。
# 自托管示例：http://127.0.0.1:8081（不要带末尾 `/`）。
# 使用 --local 启动官方 telegram-bot-api 时，视频上传上限可提高到 2 GB。
TELEGRAM_API_ROOT=

# === MTProto / mtcute（突破 Bot API 50MB 上传上限，支持到 2GB） ===
# 在 https://my.telegram.org 免费申请 api_id & api_hash
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# 持久化的 MTProto session 字符串（由 scripts/auth-mtproto.ts 一次性生成）。
# 留空时进程会以 bot token 登录并把新 session 打印到日志，需要把它再贴回这里。
TELEGRAM_MT_PROTO_SESSION=
